<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Numbers always look the same, whatever the Windows language is. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- The Java client lives here too but is not part of the C# build. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);java\**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
