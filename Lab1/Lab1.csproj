<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Numbers are always written as "-1234" with '.' as decimal point, whatever the Windows language is. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Every method is fully optimised from its first call, so JIT warm-up does not distort the timings. -->
    <TieredCompilation>false</TieredCompilation>

    <!-- The Java version, the report generator and the results live here too but are not part of the C# build. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);java\**;report\**;results\**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
